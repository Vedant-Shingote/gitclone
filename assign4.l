/* ============================================================
   Assignment 4 — LEX file (companion to assign4.y)
   Lexer for the YACC Arithmetic Expression Evaluator

   HOW TO USE (together with assign4.y):
   ======================================
   Step 1: flex assign4.l          → produces lex.yy.c
   Step 2: bison -d assign4.y      → produces assign4.tab.c + assign4.tab.h
   Step 3: gcc lex.yy.c assign4.tab.c -o assign4 -lm
   Step 4: ./assign4
   ======================================
   ============================================================ */

%{
#include "assign4.tab.h"   /* generated by bison -d assign4.y */
#include <string.h>
#include <stdlib.h>
%}

%%

[ \t]+           { /* skip spaces and tabs */ }

\n               { return NEWLINE; }

[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?  {
                     yylval.dval = atof(yytext);
                     return NUMBER;
                 }

[a-zA-Z_][a-zA-Z0-9_]*  {
                     strncpy(yylval.sval, yytext, 63);
                     yylval.sval[63] = '\0';
                     return NAME;
                 }

"+"  { return '+'; }
"-"  { return '-'; }
"*"  { return '*'; }
"/"  { return '/'; }
"("  { return '('; }
")"  { return ')'; }
"="  { return '='; }

.    { /* ignore any other character */ }

%%

int yywrap() { return 1; }
